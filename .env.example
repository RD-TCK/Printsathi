# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay Configuration
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
PRINTIVA_SERVER_URL=http://localhost:3000

# Office conversion runs on the web server (LibreOffice must be installed there).
# Windows default: C:/Program Files/LibreOffice/program/soffice.exe
# Linux example: /usr/bin/libreoffice
LIBREOFFICE_PATH=

# Optional: hosted Windows executable URL. Without it, /api/agent/download
# serves the local dist/PrintivaAgent.exe produced by npm run build:agent.
AGENT_DOWNLOAD_URL=
AGENT_BINARY_PATH=
