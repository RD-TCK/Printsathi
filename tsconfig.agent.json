{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "./dist/agent",
    "rootDir": "./src/agent",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/agent/**/*"],
  "exclude": ["node_modules", "dist", "src/agent/agent.test.ts"]
}
